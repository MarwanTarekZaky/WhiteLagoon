@model IEnumerable<WhiteLagoon.Domain.Entities.Villa>


<div class="w-100 card border-0 p-4">
    <div class="card-header bg-gradient bg-success ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Villa List</h2>
            </div>
        </div>
    </div>
    <div class="card-body border py-4">
        <div class="pb-3  row">
            <div class="col-6 offset-6 text-end">
                <a class="btn btn-secondary" asp-action="Create" asp-controller="Villa">
                    <i class="bi bi-house-add m-2 py-2 p-2"></i>Create Villa
                </a>
            </div>
        </div>
        <table class="table table-bordered table-striped table-hover">
            <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Sqft</th>
                <th>Occupancy</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Name</td>
                    <td>@obj.Price</td>
                    <td>@obj.Sqft</td>
                    <td>@obj.Occupancy</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-action="Edit" asp-controller="Villa" asp-route-villaID="@obj.Id" class="btn btn-success mx-2">
                                <i class="bi bi-pencil"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-controller="Villa" asp-route-villaID="@obj.Id" class="btn btn-danger mx-2">
                                <i class="bi bi-trash-fill"></i>Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>






